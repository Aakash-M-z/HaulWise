# =====================================================
# HaulWise Django Backend - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# Django Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-secure-secret-key-here

# Debug mode - set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS allowed origins for your frontend (optional)
# CORS_ALLOWED_ORIGINS=https://haul-wise-web.vercel.app
